# Frontend dev + prod public env vars.
# Vite prefixi `VITE_` — build sırasında bundle'a gömülür.

# Vite dev sunucusu — port override (bu makinede sibling proje çakışmasını önlemek için 5501)
VITE_PORT=5501

# API taban URL'i (dev proxy hedefi). Backend PORT ile eşleşmeli
VITE_API_TARGET=http://localhost:4501

# Public site taban URL — canonical/OG/JSON-LD absolute URL üretimi.
# Faz 9 subdomain hazırlığı: subdomain'e taşınırken tek satır değişir.
VITE_PUBLIC_BASE_URL=https://beylink.org

# Site adı — SEO helper (lib/seo.js) tarafından title/JSON-LD'de kullanılır
VITE_SITE_NAME=BeyLink
