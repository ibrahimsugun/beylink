# docker-compose için üretim değişkenleri
# Kullanım: cp .env.example .env && docker compose up -d --build

# JWT imzalama anahtarı (mutlaka değiştir)
JWT_SECRET=please-change-this-secret

# CORS origin (aynı origin dağıtımda '*' yeterli)
CLIENT_ORIGIN=*

# Public profil/QR taban URL'si (web servisinin dışarıya açık adresi)
PUBLIC_BASE_URL=http://localhost:8501

# Admin dashboard yetkisi verilecek e-postalar (virgülle ayrık). Varsayılan: admin@example.com
ADMIN_EMAILS=admin@example.com

# --- Özel alan adı (branded domain, yalnız Pro Plus) ---
# BeyLink'in KENDİ hostname'leri — resolveHost middleware bu listede OLMAYAN her Host'u kullanıcı
# domaini sayar (Caddyfile de aynı listeyi zımnen bilir: beylink.org/www dışındaki her host'u
# on-demand TLS + `ask` kapısından geçirir). Prod'da domain'inizi eklemeyi unutmayın.
APP_HOSTNAMES=beylink.org,www.beylink.org,localhost,127.0.0.1
# Apex/kök domain doğrulaması için A kaydı hedefi — sunucunuzun statik IP'si. Boşsa yalnız CNAME
# doğrulaması geçerli olur (dev'de genelde boş bırakılır).
BRANDED_DOMAIN_SERVER_IP=
# Subdomain (www/links vb.) doğrulaması için CNAME hedefi.
BRANDED_DOMAIN_CNAME_TARGET=cname.beylink.org

# --- E-posta (şifre sıfırlama + e-posta doğrulama) ---
# Sağlayıcı önceliği: (1) RESEND_API_KEY → Resend HTTP API · (2) MAIL_ENABLED=true → SMTP · (3) demo.
# Demo (hiçbiri yok): gerçek e-posta GÖNDERİLMEZ; token API yanıtında döner (yalnız NODE_ENV!=production).
#
# ÖNERİLEN: Resend (resend.com). ÖNEMLİ — gönderim için kendi DOMAIN'inizi doğrulamanız gerekir:
#   • Gmail (@gmail.com) ile gönderemezsiniz (domain'i doğrulayamazsınız → DKIM eşleşmez → spam).
#   • Domain doğrulanana kadar yalnız 'onboarding@resend.dev' adresinden ve YALNIZCA kendi Resend
#     hesap e-postanıza gönderebilirsiniz. Domain doğrulayınca MAIL_FROM'u o domain'e çevirin.
RESEND_API_KEY=
MAIL_FROM=BeyLink <onboarding@resend.dev>
MAIL_REPLY_TO=
# SMTP (alternatif, Resend yoksa). Gerçek gönderim için mailer.js sendMail'de SMTP dalını doldurun.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# E-postadaki bağlantılar (reset/verify) + panel linkleri için uygulama (frontend) taban URL'si.
APP_URL=http://localhost:8501

# --- USDT TRC-20 ödeme doğrulama (self-custody, komisyonsuz) ---
# Alıcı cüzdan adresiniz (SOĞUK CÜZDAN — private key BU SUNUCUYA ASLA KOYMAYIN).
# Boş bırakılırsa poll döngüsü hiç başlamaz ve gerçek "Kredi Yükle" 503 döner (demo yine çalışır).
TRC20_WALLET_ADDRESS=
# Whitelist edilen USDT TRC-20 kontrat adresi (mainnet, DEĞİŞTİRMEYİN)
TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Krediyi yüklemek için beklenen onay sayısı (test: 1, mainnet: ~19)
TRC20_MIN_CONFIRMATIONS=1
# TronGrid API anahtarı — free tier de çalışır; anahtar ile rate limit rahatlar
TRONGRID_API_KEY=
# Fatura geçerlilik süresi (dakika)
PAYMENT_TTL_MINUTES=15
# Poll döngüsü aralığı (saniye)
PAYMENT_POLL_INTERVAL_SECONDS=30
# İzin verilen tutar aralığı (USDT)
PAYMENT_MIN_USD=1
PAYMENT_MAX_USD=10000
# Demo ödeme (anında kredi — test). ÜRETİMDE MUTLAKA false yapın.
DEMO_PAYMENTS=false
