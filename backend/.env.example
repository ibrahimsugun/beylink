NODE_ENV=development
PORT=4501

# JWT
JWT_SECRET=change-this-in-production-please
JWT_EXPIRES_IN=7d

# Veritabanı (varsayılan: backend/data/beylink.sqlite)
# DB_PATH=./data/beylink.sqlite

# Yüklemeler (varsayılan: backend/uploads)
# UPLOADS_DIR=./uploads

# CORS — frontend origin
CLIENT_ORIGIN=http://localhost:5501

# Public profil taban URL'si (QR ve paylaşım için)
PUBLIC_BASE_URL=http://localhost:5501
# Sitemap/robots/feed için sabit canlı URL — dev URL'lerin sitemap'e sızmasını engeller.
# Google Search Console bunu canonical URL olarak indeksler; boşsa "https://beylink.org" varsayılır.
SITEMAP_BASE_URL=https://beylink.org

# Admin dashboard yetkisi verilecek e-postalar (virgülle ayrık). Varsayılan: admin@example.com
ADMIN_EMAILS=admin@example.com

# --- E-posta gönderimi (Resend önerilir) ---
# RESEND_API_KEY doluysa gerçek e-posta Resend HTTP API ile gider (ekstra npm yok).
# ÖNEMLİ: Gmail ile gönderilmez — kendi domain'inizi resend.com/domains'te doğrulayın.
# Domain doğrulanana kadar yalnız onboarding@resend.dev'den + kendi Resend hesap e-postanıza gider.
RESEND_API_KEY=
MAIL_FROM=BeyLink <onboarding@resend.dev>
MAIL_REPLY_TO=
# E-postadaki bağlantılar + panel linkleri için taban URL (frontend). Dev: http://localhost:5501
APP_URL=http://localhost:5501

# --- USDT (TRC20) ödemeleri (self-custody) ---
# Alıcı cüzdan adresi (SADECE alım; private key sunucuda TUTULMAZ).
# Boş bırakılırsa gerçek ödeme poller'ı kapalı kalır ve DEMO_PAYMENTS devreye girer.
TRC20_WALLET_ADDRESS=
# USDT TRC20 kontrat adresi (mainnet varsayılan)
TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TronGrid API anahtarı (mainnet için önerilir; testnet gerektirmez)
TRONGRID_API_KEY=
TRC20_MIN_CONFIRMATIONS=19
PAYMENT_TTL_MINUTES=30
PAYMENT_POLL_INTERVAL_SECONDS=30
PAYMENT_MIN_USD=1
PAYMENT_MAX_USD=10000
# Demo mod: ödeme anında onaylanır (istemciye güvenir). Prod'da false yapın.
DEMO_PAYMENTS=true
